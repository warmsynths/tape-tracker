--- /dev/null
+++ b/core/libs/Audio/play_loop.h
@@ -0,0 +1,31 @@
+#ifndef play_loop_h_
+#define play_loop_h_
+
+#include "AudioStream.h"
+#include "loop_fill.h"
+
+// Plays one mono 16-bit region of memory in a seamless loop. Used by the four-track
+// test build to play back a recorded Part. Output 0 carries the mono signal.
+class AudioPlayLoop : public AudioStream
+{
+  public:
+    AudioPlayLoop()
+      : AudioStream(0, NULL)
+    {
+    }
+
+    // Starts looping `lengthFrames` samples at `data` from the beginning.
+    void play(const int16_t* data, uint32_t lengthFrames);
+    void stop();
+    bool isPlaying() const { return playing; }
+
+    virtual void update(void) override;
+
+  private:
+    const int16_t* volatile loopData = nullptr;
+    volatile uint32_t loopLength = 0;
+    uint32_t position = 0;
+    volatile bool playing = false;
+};
+
+#endif
diff --git a/core/source/FourTrackLoop.cpp b/core/source/FourTrackLoop.cpp
new file mode 100644
index 0000000..7986a70
--- /dev/null
+++ b/core/source/FourTrackLoop.cpp
@@ -0,0 +1,61 @@
+#include "FourTrackLoop.h"
+
+void FourTrackLoop::pressRecord()
+{
+    if (currentState == State::Recording)
+    {
+        return;
+    }
+    frames = 0;
+    full = false;
+    currentState = State::Recording;
+}
+
+void FourTrackLoop::recordedFrames(uint32_t capturedFrames, bool memoryFull)
+{
+    if (currentState != State::Recording)
+    {
+        return;
+    }
+
+    frames = capturedFrames;
+    if (frames >= maxFrames)
+    {
+        frames = maxFrames;
+        full = true;
+    }
+    else if (memoryFull)
+    {
+        full = true;
+    }
+
+    if (full)
+    {
+        finishRecording();
+    }
+}
+
+void FourTrackLoop::pressStop()
+{
+    if (currentState == State::Recording)
+    {
+        finishRecording();
+    }
+    else if (currentState == State::Playing)
+    {
+        currentState = State::Ready;
+    }
+}
+
+void FourTrackLoop::pressPlay()
+{
+    if (currentState == State::Ready)
+    {
+        currentState = State::Playing;
+    }
+}
+
+void FourTrackLoop::finishRecording()
+{
+    currentState = (frames > 0) ? State::Ready : State::Empty;
+}
diff --git a/core/source/FourTrackLoop.h b/core/source/FourTrackLoop.h
new file mode 100644
index 0000000..7c300d9
--- /dev/null
+++ b/core/source/FourTrackLoop.h
@@ -0,0 +1,47 @@
+#ifndef FOURTRACKLOOP_H_
+#define FOURTRACKLOOP_H_
+
+#include <stdint.h>
+
+// Pure state machine for the first test build: one mono Part that is recorded once and looped.
+// No hardware dependencies, so it is tested on a PC (tests/host/four_track_loop_test.cpp).
+class FourTrackLoop
+{
+  public:
+    enum class State : uint8_t
+    {
+        Empty,
+        Recording,
+        Ready,
+        Playing
+    };
+
+    explicit FourTrackLoop(uint32_t maxFrames)
+      : maxFrames(maxFrames)
+    {
+    }
+
+    State state() const { return currentState; }
+    uint32_t lengthFrames() const { return frames; }
+    bool memoryFull() const { return full; }
+
+    // Starts a new recording. Discards any earlier Part. Ignored while already recording.
+    void pressRecord();
+    // Called while recording with the number of frames captured so far.
+    // Stops by itself, keeping what was recorded, at the cap or when memoryFull is true.
+    void recordedFrames(uint32_t capturedFrames, bool memoryFull);
+    // Recording: keeps the take (or stays empty if nothing was captured). Playing: back to Ready.
+    void pressStop();
+    // Ready: starts looping. Ignored in every other state.
+    void pressPlay();
+
+  private:
+    void finishRecording();
+
+    uint32_t maxFrames;
+    uint32_t frames = 0;
+    bool full = false;
+    State currentState = State::Empty;
+};
+
+#endif /* FOURTRACKLOOP_H_ */
