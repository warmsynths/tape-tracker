diff --git a/core/libs/Audio/play_loop.cpp b/core/libs/Audio/play_loop.cpp
new file mode 100644
index 0000000..32300bd
--- /dev/null
+++ b/core/libs/Audio/play_loop.cpp
@@ -0,0 +1,38 @@
+#include "play_loop.h"
+
+#include "Audio.h"
+
+void AudioPlayLoop::play(const int16_t* data, uint32_t lengthFrames)
+{
+    AudioNoInterrupts();
+    loopData = data;
+    loopLength = lengthFrames;
+    position = 0;
+    playing = (data != nullptr && lengthFrames > 0);
+    AudioInterrupts();
+}
+
+void AudioPlayLoop::stop()
+{
+    AudioNoInterrupts();
+    playing = false;
+    AudioInterrupts();
+}
+
+void AudioPlayLoop::update(void)
+{
+    if (!playing)
+    {
+        return;
+    }
+
+    audio_block_t* block = allocate();
+    if (block == nullptr)
+    {
+        return;
+    }
+
+    loopFillBlock(loopData, loopLength, position, block->data, AUDIO_BLOCK_SAMPLES);
+    transmit(block, 0);
+    release(block);
+}
diff --git a/core/libs/Audio/play_loop.h b/core/libs/Audio/play_loop.h
new file mode 100644
