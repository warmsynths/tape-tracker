diff --git a/core/libs/Audio/play_loops.cpp b/core/libs/Audio/play_loops.cpp
new file mode 100644
index 0000000..54bb982
--- /dev/null
+++ b/core/libs/Audio/play_loops.cpp
@@ -0,0 +1,70 @@
+#include "play_loops.h"
+
+#include "Audio.h"
+
+void AudioPlayLoops::setTrack(int track, const int16_t* data)
+{
+    if (track < 0 || track >= kTracks)
+    {
+        return;
+    }
+    AudioNoInterrupts();
+    trackData[track] = data;
+    AudioInterrupts();
+}
+
+void AudioPlayLoops::setMute(int track, bool mute)
+{
+    if (track < 0 || track >= kTracks)
+    {
+        return;
+    }
+    muted[track] = mute;
+}
+
+void AudioPlayLoops::start(uint32_t lengthFrames)
+{
+    AudioNoInterrupts();
+    loopLength = lengthFrames;
+    currentPosition = 0;
+    playing = (lengthFrames > 0);
+    AudioInterrupts();
+}
+
+void AudioPlayLoops::stop()
+{
+    AudioNoInterrupts();
+    playing = false;
+    AudioInterrupts();
+}
+
+void AudioPlayLoops::update(void)
+{
+    if (!playing)
+    {
+        return;
+    }
+
+    audio_block_t* block = allocate();
+    if (block == nullptr)
+    {
+        return;
+    }
+
+    const int16_t* active[kTracks];
+    for (int t = 0; t < kTracks; t++)
+    {
+        active[t] = muted[t] ? nullptr : trackData[t];
+    }
+
+    const uint32_t length = loopLength;
+    loopMixBlock(active, kTracks, length, currentPosition, block->data, AUDIO_BLOCK_SAMPLES);
+
+    if (length > 0)
+    {
+        currentPosition = (currentPosition + AUDIO_BLOCK_SAMPLES) % length;
+    }
+
+    transmit(block, 0);
+    release(block);
+}
diff --git a/core/libs/Audio/play_loops.h b/core/libs/Audio/play_loops.h
new file mode 100644
index 0000000..765b6e3
--- /dev/null
+++ b/core/libs/Audio/play_loops.h
@@ -0,0 +1,42 @@
+#ifndef play_loops_h_
+#define play_loops_h_
+
+#include "AudioStream.h"
+#include "loop_fill.h"
+
+// Plays up to four mono 16-bit regions of memory as looping tracks that share one loop length
+// and one position, so they stay in sync. Output 0 carries the mono mix.
+class AudioPlayLoops : public AudioStream
+{
+  public:
+    static constexpr int kTracks = 4;
+
+    AudioPlayLoops()
+      : AudioStream(0, NULL)
+    {
+    }
+
+    // `data` is the start of the track's samples, or nullptr for an empty track.
+    void setTrack(int track, const int16_t* data);
+    void setMute(int track, bool mute);
+
+    // Starts all tracks from the beginning, each `lengthFrames` long.
+    void start(uint32_t lengthFrames);
+    void stop();
+    bool isPlaying() const { return playing; }
+
+    // Frame position where the next block starts, and the loop length.
+    uint32_t position() const { return currentPosition; }
+    uint32_t length() const { return loopLength; }
+
+    virtual void update(void) override;
+
+  private:
+    const int16_t* volatile trackData[kTracks] = {};
+    volatile bool muted[kTracks] = {};
+    volatile uint32_t loopLength = 0;
+    volatile uint32_t currentPosition = 0;
+    volatile bool playing = false;
+};
+
+#endif
diff --git a/core/source/FourTrackSession.cpp b/core/source/FourTrackSession.cpp
new file mode 100644
index 0000000..737ab18
--- /dev/null
+++ b/core/source/FourTrackSession.cpp
@@ -0,0 +1,124 @@
+#include "FourTrackSession.h"
+
+int FourTrackSession::partCount() const
+{
+    int n = 0;
+    for (int i = 0; i < kTracks; i++)
+    {
+        if (parts[i])
+        {
+            n++;
+        }
+    }
+    return n;
+}
+
+void FourTrackSession::selectTrack(int track)
+{
+    if (currentMode != Mode::Idle || track < 0 || track >= kTracks)
+    {
+        return;
+    }
+    selectedTrack = track;
+}
+
+void FourTrackSession::pressRecord()
+{
+    if (currentMode != Mode::Idle)
+    {
+        return;
+    }
+
+    activeTrack = selectedTrack;
+    const bool onlyPartIsThis = (partCount() == 1 && parts[selectedTrack]);
+    if (loop == 0 || onlyPartIsThis)
+    {
+        currentMode = Mode::RecordingFirst;
+        firstFrames = 0;
+        full = false;
+        isPlaying = false;
+    }
+    else
+    {
+        currentMode = Mode::Armed;
+        isPlaying = true;
+    }
+}
+
+void FourTrackSession::pressStop()
+{
+    switch (currentMode)
+    {
+        case Mode::RecordingFirst: finishFirst(firstFrames); break;
+        case Mode::Armed:
+        case Mode::RecordingPart: currentMode = Mode::Idle; break;
+        case Mode::Idle: isPlaying = false; break;
+    }
+}
+
+void FourTrackSession::pressPlay()
+{
+    if (currentMode == Mode::Idle && loop > 0)
+    {
+        isPlaying = true;
+    }
+}
+
+void FourTrackSession::firstRecordedFrames(uint32_t frames, bool memoryFull)
+{
+    if (currentMode != Mode::RecordingFirst)
+    {
+        return;
+    }
+
+    firstFrames = frames;
+    if (firstFrames >= maxFrames)
+    {
+        firstFrames = maxFrames;
+        full = true;
+    }
+    else if (memoryFull)
+    {
+        full = true;
+    }
+
+    if (full)
+    {
+        finishFirst(firstFrames);
+    }
+}
+
+void FourTrackSession::armWindowReached()
+{
+    if (currentMode == Mode::Armed)
+    {
+        currentMode = Mode::RecordingPart;
+    }
+}
+
+void FourTrackSession::partRecorded()
+{
+    if (currentMode == Mode::RecordingPart)
+    {
+        parts[activeTrack] = true;
+        currentMode = Mode::Idle;
+    }
+}
+
+void FourTrackSession::finishFirst(uint32_t frames)
+{
+    currentMode = Mode::Idle;
+    if (frames == 0)
+    {
+        // Nothing recorded: keep whatever was there before.
+        isPlaying = (loop > 0);
+        return;
+    }
+
+    loop = frames;
+    for (int i = 0; i < kTracks; i++)
+    {
+        parts[i] = (i == activeTrack);
+    }
+    isPlaying = true;
+}
diff --git a/core/source/FourTrackSession.h b/core/source/FourTrackSession.h
new file mode 100644
index 0000000..d210765
--- /dev/null
+++ b/core/source/FourTrackSession.h
@@ -0,0 +1,68 @@
+#ifndef FOURTRACKSESSION_H_
+#define FOURTRACKSESSION_H_
+
+#include <stdint.h>
+
+// Pure logic for the four-track test build: which track is selected, what Rec, Stop and Play
+// do in each mode, and when a Part exists. No hardware, so it is tested on a PC
+// (tests/host/four_track_session_test.cpp). The engine glue reports events to it.
+class FourTrackSession
+{
+  public:
+    static constexpr int kTracks = 4;
+
+    enum class Mode : uint8_t
+    {
+        Idle,
+        RecordingFirst, // free length; its length becomes the loop
+        Armed,          // waiting for the loop to come round
+        RecordingPart   // recording exactly one loop
+    };
+
+    explicit FourTrackSession(uint32_t maxLoopFrames)
+      : maxFrames(maxLoopFrames)
+    {
+    }
+
+    Mode mode() const { return currentMode; }
+    bool playing() const { return isPlaying; }
+    int selected() const { return selectedTrack; }
+    uint32_t loopFrames() const { return loop; }
+    bool memoryFull() const { return full; }
+    bool hasPart(int track) const { return track >= 0 && track < kTracks && parts[track]; }
+    int partCount() const;
+    // The track being recorded or armed, or -1.
+    int recordingTrack() const { return currentMode == Mode::Idle ? -1 : activeTrack; }
+
+    // Only changes the selection while idle.
+    void selectTrack(int track);
+
+    // Idle with no loop, or re-recording the only Part: a new first take (free length).
+    // Idle with a loop: arm the selected track (starts the loop if stopped).
+    void pressRecord();
+    // First take: keeps what was recorded and starts the loop. Armed or recording a Part: cancels,
+    // keeping the old Part. Idle: stops the loop.
+    void pressStop();
+    // Idle with a loop: starts it.
+    void pressPlay();
+
+    // Events from the engine side.
+    void firstRecordedFrames(uint32_t frames, bool memoryFull); // during RecordingFirst
+    void armWindowReached();                                    // Armed -> RecordingPart
+    void partRecorded();                                        // RecordingPart -> Idle
+
+  private:
+    void finishFirst(uint32_t frames);
+
+    uint32_t maxFrames;
+    uint32_t loop = 0;
+    uint32_t firstFrames = 0;
+    bool full = false;
+    bool isPlaying = false;
+    bool parts[kTracks] = { false, false, false, false };
+    int selectedTrack = 0;
+    int activeTrack = 0;
+    Mode currentMode = Mode::Idle;
+};
+
+#endif /* FOURTRACKSESSION_H_ */
