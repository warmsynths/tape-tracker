diff --git a/tests/host/four_track_session_test.cpp b/tests/host/four_track_session_test.cpp
new file mode 100644
index 0000000..b00c4fa
--- /dev/null
+++ b/tests/host/four_track_session_test.cpp
@@ -0,0 +1,164 @@
+#include "../../core/source/FourTrackSession.h"
+
+#include <cstdio>
+
+static int failures = 0;
+#define CHECK(cond, msg)                                       \
+    do                                                         \
+    {                                                          \
+        if (!(cond))                                           \
+        {                                                      \
+            std::printf("FAIL: %s (line %d)\n", msg, __LINE__); \
+            failures++;                                        \
+        }                                                      \
+    } while (0)
+
+using Mode = FourTrackSession::Mode;
+
+static FourTrackSession withLoop(uint32_t maxFrames, uint32_t loopFrames)
+{
+    FourTrackSession s(maxFrames);
+    s.pressRecord();
+    s.firstRecordedFrames(loopFrames, false);
+    s.pressStop();
+    return s;
+}
+
+int main()
+{
+    const uint32_t kMax = 1000;
+
+    {
+        FourTrackSession s(kMax);
+        CHECK(s.mode() == Mode::Idle && s.loopFrames() == 0 && !s.playing(), "starts idle, empty, stopped");
+        CHECK(s.selected() == 0, "track 1 selected");
+        s.pressPlay();
+        CHECK(!s.playing(), "play with no loop does nothing");
+        s.pressStop();
+        CHECK(s.mode() == Mode::Idle, "stop with nothing does nothing");
+    }
+    {   // first Part sets the loop and starts playing
+        FourTrackSession s(kMax);
+        s.pressRecord();
+        CHECK(s.mode() == Mode::RecordingFirst && s.recordingTrack() == 0, "rec with no loop records the first Part");
+        s.firstRecordedFrames(400, false);
+        s.pressStop();
+        CHECK(s.mode() == Mode::Idle && s.loopFrames() == 400 && s.hasPart(0), "stop keeps the first Part and sets the loop");
+        CHECK(s.playing(), "loop plays right after the first Part");
+        CHECK(!s.memoryFull(), "not full");
+    }
+    {   // nothing recorded keeps things empty
+        FourTrackSession s(kMax);
+        s.pressRecord();
+        s.pressStop();
+        CHECK(s.loopFrames() == 0 && !s.hasPart(0) && s.mode() == Mode::Idle, "stop with zero frames sets no loop");
+    }
+    {   // the first Part can be on any track
+        FourTrackSession s(kMax);
+        s.selectTrack(2);
+        s.pressRecord();
+        s.firstRecordedFrames(300, false);
+        s.pressStop();
+        CHECK(s.hasPart(2) && !s.hasPart(0) && s.loopFrames() == 300, "first Part on track 3");
+    }
+    {   // memory cap stops the first take by itself and keeps it
+        FourTrackSession s(kMax);
+        s.pressRecord();
+        s.firstRecordedFrames(kMax + 50, false);
+        CHECK(s.mode() == Mode::Idle && s.loopFrames() == kMax && s.memoryFull(), "cap stops and clamps the first Part");
+        FourTrackSession t(kMax);
+        t.pressRecord();
+        t.firstRecordedFrames(700, true);
+        CHECK(t.mode() == Mode::Idle && t.loopFrames() == 700 && t.memoryFull(), "memory full below the cap keeps the take");
+    }
+    {   // a later Part: arm, window, record, done
+        FourTrackSession s = withLoop(kMax, 500);
+        s.selectTrack(1);
+        s.pressRecord();
+        CHECK(s.mode() == Mode::Armed && s.recordingTrack() == 1, "rec on another track arms it");
+        CHECK(s.playing(), "arming keeps the loop playing");
+        s.armWindowReached();
+        CHECK(s.mode() == Mode::RecordingPart, "window reached starts recording");
+        s.partRecorded();
+        CHECK(s.mode() == Mode::Idle && s.hasPart(1) && s.hasPart(0) && s.loopFrames() == 500, "Part added, loop unchanged");
+        CHECK(s.playing(), "still playing");
+    }
+    {   // arming from stopped starts the loop
+        FourTrackSession s = withLoop(kMax, 500);
+        s.pressStop();
+        CHECK(!s.playing(), "stopped");
+        s.selectTrack(1);
+        s.pressRecord();
+        CHECK(s.mode() == Mode::Armed && s.playing(), "arm from stopped starts playing");
+    }
+    {   // stop cancels an armed or running part and keeps the old state
+        FourTrackSession s = withLoop(kMax, 500);
+        s.selectTrack(1);
+        s.pressRecord();
+        s.pressStop();
+        CHECK(s.mode() == Mode::Idle && !s.hasPart(1) && s.playing(), "stop cancels the arm and keeps playing");
+        s.pressRecord();
+        s.armWindowReached();
+        s.pressStop();
+        CHECK(s.mode() == Mode::Idle && !s.hasPart(1) && s.playing(), "stop discards a take in progress");
+        s.pressStop();
+        CHECK(!s.playing(), "stop again stops the loop");
+        s.pressPlay();
+        CHECK(s.playing(), "play restarts it");
+    }
+    {   // re-recording a track that has a Part replaces it on the next take, keeps the old one if cancelled
+        FourTrackSession s = withLoop(kMax, 500);
+        s.selectTrack(1);
+        s.pressRecord();
+        s.armWindowReached();
+        s.partRecorded();
+        s.pressRecord(); // track 2 again
+        s.pressStop();
+        CHECK(s.hasPart(1), "a cancelled re-record keeps the old Part");
+    }
+    {   // the only Part can be re-recorded from scratch, which redefines the loop
+        FourTrackSession s = withLoop(kMax, 500);
+        s.pressRecord();
+        CHECK(s.mode() == Mode::RecordingFirst, "re-recording the only Part is a new first take");
+        s.pressStop(); // nothing recorded
+        CHECK(s.loopFrames() == 500 && s.hasPart(0), "cancelled new first take keeps the old loop");
+        s.pressRecord();
+        s.firstRecordedFrames(250, false);
+        s.pressStop();
+        CHECK(s.loopFrames() == 250, "a new first take redefines the loop");
+    }
+    {   // with two Parts, re-recording the first is a normal later take
+        FourTrackSession s = withLoop(kMax, 500);
+        s.selectTrack(1);
+        s.pressRecord();
+        s.armWindowReached();
+        s.partRecorded();
+        s.selectTrack(0);
+        s.pressRecord();
+        CHECK(s.mode() == Mode::Armed, "with other Parts present, re-recording track 1 is a normal take");
+    }
+    {   // selecting and ignoring
+        FourTrackSession s = withLoop(kMax, 500);
+        s.selectTrack(3);
+        CHECK(s.selected() == 3, "select track 4");
+        s.selectTrack(9);
+        CHECK(s.selected() == 3, "out of range select is ignored");
+        s.pressRecord();
+        s.selectTrack(1);
+        CHECK(s.selected() == 3, "cannot change track while armed");
+        s.armWindowReached();
+        s.pressRecord();
+        CHECK(s.mode() == Mode::RecordingPart, "rec while recording is ignored");
+        s.pressPlay();
+        CHECK(s.mode() == Mode::RecordingPart, "play while recording is ignored");
+    }
+    {   // events in the wrong mode are ignored
+        FourTrackSession s(kMax);
+        s.armWindowReached();
+        s.partRecorded();
+        s.firstRecordedFrames(100, false);
+        CHECK(s.mode() == Mode::Idle && s.loopFrames() == 0, "stray events do nothing");
+    }
+    std::printf(failures ? "%d FAILED\n" : "all passed\n", failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/host/loop_fill_test.cpp b/tests/host/loop_fill_test.cpp
new file mode 100644
index 0000000..d85dd80
--- /dev/null
+++ b/tests/host/loop_fill_test.cpp
@@ -0,0 +1,72 @@
+#include "../../core/libs/Audio/loop_fill.h"
+
+#include <cstdio>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond, msg)                                       \
+    do                                                         \
+    {                                                          \
+        if (!(cond))                                           \
+        {                                                      \
+            std::printf("FAIL: %s (line %d)\n", msg, __LINE__); \
+            failures++;                                        \
+        }                                                      \
+    } while (0)
+
+int main()
+{
+    // Wraps across the end: three blocks of 4 over a loop of 6 repeat the data with no gap.
+    {
+        const int16_t data[6] = { 1, 2, 3, 4, 5, 6 };
+        uint32_t pos = 0;
+        std::vector<int16_t> out;
+        for (int b = 0; b < 3; b++)
+        {
+            int16_t blk[4];
+            loopFillBlock(data, 6, pos, blk, 4);
+            out.insert(out.end(), blk, blk + 4);
+        }
+        const int16_t expect[12] = { 1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6 };
+        bool same = out.size() == 12;
+        for (int i = 0; same && i < 12; i++) same = out[i] == expect[i];
+        CHECK(same, "loop repeats data with no gap across the boundary");
+        CHECK(pos == 0, "position is back to 0 after 12 samples of a 6 loop");
+    }
+    // Position advances modulo length.
+    {
+        const int16_t data[5] = { 10, 20, 30, 40, 50 };
+        uint32_t pos = 3;
+        int16_t blk[4];
+        loopFillBlock(data, 5, pos, blk, 4);
+        CHECK(blk[0] == 40 && blk[1] == 50 && blk[2] == 10 && blk[3] == 20, "starts from position and wraps");
+        CHECK(pos == 2, "position advanced modulo length");
+    }
+    // Length 0 gives silence and leaves position at 0.
+    {
+        uint32_t pos = 7;
+        int16_t blk[4] = { 9, 9, 9, 9 };
+        loopFillBlock(nullptr, 0, pos, blk, 4);
+        CHECK(blk[0] == 0 && blk[1] == 0 && blk[2] == 0 && blk[3] == 0, "zero length gives zeros");
+        CHECK(pos == 0, "zero length resets position");
+    }
+    // Loop shorter than the block repeats several times inside one block.
+    {
+        const int16_t data[2] = { 7, 8 };
+        uint32_t pos = 0;
+        int16_t blk[5];
+        loopFillBlock(data, 2, pos, blk, 5);
+        CHECK(blk[0] == 7 && blk[1] == 8 && blk[2] == 7 && blk[3] == 8 && blk[4] == 7, "short loop repeats inside one block");
+        CHECK(pos == 1, "position after odd count");
+    }
+    // A position beyond the length (for example after a shorter new recording) is brought back in range.
+    {
+        const int16_t data[3] = { 1, 2, 3 };
+        uint32_t pos = 100;
+        int16_t blk[3];
+        loopFillBlock(data, 3, pos, blk, 3);
+        CHECK(pos < 3, "out of range position is wrapped");
+    }
+    std::printf(failures ? "%d FAILED\n" : "all passed\n", failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/host/loop_mix_test.cpp b/tests/host/loop_mix_test.cpp
new file mode 100644
index 0000000..056a6c3
--- /dev/null
+++ b/tests/host/loop_mix_test.cpp
@@ -0,0 +1,76 @@
+#include "../../core/libs/Audio/loop_fill.h"
+
+#include <cstdio>
+
+static int failures = 0;
+#define CHECK(cond, msg)                                       \
+    do                                                         \
+    {                                                          \
+        if (!(cond))                                           \
+        {                                                      \
+            std::printf("FAIL: %s (line %d)\n", msg, __LINE__); \
+            failures++;                                        \
+        }                                                      \
+    } while (0)
+
+int main()
+{
+    // Two tracks are summed sample by sample.
+    {
+        const int16_t a[4] = { 1, 2, 3, 4 };
+        const int16_t b[4] = { 10, 20, 30, 40 };
+        const int16_t* tracks[2] = { a, b };
+        int16_t out[4];
+        loopMixBlock(tracks, 2, 4, 0, out, 4);
+        CHECK(out[0] == 11 && out[1] == 22 && out[2] == 33 && out[3] == 44, "two tracks sum");
+    }
+    // The block wraps past the end of the loop with no gap, for every track.
+    {
+        const int16_t a[3] = { 1, 2, 3 };
+        const int16_t b[3] = { 100, 200, 300 };
+        const int16_t* tracks[2] = { a, b };
+        int16_t out[5];
+        loopMixBlock(tracks, 2, 3, 2, out, 5); // starts at the last sample
+        CHECK(out[0] == 303 && out[1] == 101 && out[2] == 202 && out[3] == 303 && out[4] == 101, "wraps together");
+    }
+    // A null track is silent and the others still play.
+    {
+        const int16_t a[2] = { 5, 6 };
+        const int16_t* tracks[3] = { nullptr, a, nullptr };
+        int16_t out[2];
+        loopMixBlock(tracks, 3, 2, 0, out, 2);
+        CHECK(out[0] == 5 && out[1] == 6, "null tracks are skipped");
+    }
+    // The sum is clipped, not wrapped around.
+    {
+        const int16_t a[1] = { 30000 };
+        const int16_t b[1] = { 30000 };
+        const int16_t c[1] = { -30000 };
+        const int16_t d[1] = { -30000 };
+        const int16_t* hi[2] = { a, b };
+        const int16_t* lo[2] = { c, d };
+        int16_t out[1];
+        loopMixBlock(hi, 2, 1, 0, out, 1);
+        CHECK(out[0] == 32767, "clips high");
+        loopMixBlock(lo, 2, 1, 0, out, 1);
+        CHECK(out[0] == -32768, "clips low");
+    }
+    // Zero length or no tracks is silence.
+    {
+        int16_t out[3] = { 7, 7, 7 };
+        const int16_t a[1] = { 9 };
+        const int16_t* tracks[1] = { a };
+        loopMixBlock(tracks, 1, 0, 0, out, 3);
+        CHECK(out[0] == 0 && out[1] == 0 && out[2] == 0, "zero length is silence");
+    }
+    // A position beyond the loop length is wrapped into range.
+    {
+        const int16_t a[3] = { 1, 2, 3 };
+        const int16_t* tracks[1] = { a };
+        int16_t out[2];
+        loopMixBlock(tracks, 1, 3, 100, out, 2); // 100 % 3 == 1
+        CHECK(out[0] == 2 && out[1] == 3, "out of range position wraps");
+    }
+    std::printf(failures ? "%d FAILED\n" : "all passed\n", failures);
+    return failures ? 1 : 0;
+}
